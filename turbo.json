{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@sqlscope/web#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "@sqlscope/api#dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "@sqlscope/api#build": {
      "dependsOn": ["^build", "generate"]
    },
    "@sqlscope/api#typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "@sqlscope/api#test": {
      "dependsOn": ["^build", "generate"]
    },
    "@sqlscope/api#test:integration": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    }
  }
}
