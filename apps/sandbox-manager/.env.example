# For `pnpm dev` against `compose.dev.yaml`, which publishes the state database and the
# Docker socket proxy on localhost.
NODE_ENV=development
SANDBOX_MANAGER_TOKEN=dev-only-sandbox-manager-token-change-me
STATE_DATABASE_URL=postgres://sqlscope_sandbox_manager:sandbox-manager@localhost:15432/sqlscope_sandboxes
DOCKER_HOST=http://127.0.0.1:12375
# Keeps the containers of a local `pnpm dev` apart from the ones the compose stack owns.
MANAGER_INSTANCE=dev
