{
  "name": "@sqlscope/sandbox-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Internal service that owns the T2 sandbox containers (ADR 0002).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "8.23.1",
    "testcontainers": "12.1.0",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
