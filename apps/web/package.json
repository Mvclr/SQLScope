{
  "name": "@sqlscope/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:monaco": "node scripts/copy-monaco.mjs",
    "build": "node scripts/copy-monaco.mjs && next build",
    "dev": "node scripts/copy-monaco.mjs && next dev --port 3000",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@monaco-editor/react": "4.7.0",
    "@sqlscope/core": "workspace:*",
    "@sqlscope/engine": "workspace:*",
    "@sqlscope/explain": "workspace:*",
    "@sqlscope/scenarios": "workspace:*",
    "@sqlscope/security-rules": "workspace:*",
    "@sqlscope/sql-parser": "workspace:*",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-virtual": "3.14.13",
    "@xyflow/react": "12.11.6",
    "elkjs": "0.12.0",
    "html-to-image": "1.11.13",
    "monaco-editor": "0.56.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "vitest": "5.0.1"
  }
}
