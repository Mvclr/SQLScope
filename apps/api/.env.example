# For `pnpm dev` against `compose.dev.yaml`.
NODE_ENV=development
# Requests arrive through the Next.js /api proxy.
TRUST_PROXY=1
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
CONTROL_DATABASE_URL=postgres://sqlscope:sqlscope@localhost:15432/sqlscope
SANDBOX_DATABASE_URL=postgres://sqlscope_provisioner:sandbox-provisioner@localhost:15433/postgres
REDIS_URL=redis://:sqlscope@localhost:16379
# The sandbox manager for the T2 labs. Must match apps/sandbox-manager/.env. Under `pnpm dev`
# the API runs on the host and cannot reach the sandboxes' internal networks, so starting a
# T2 lab only works with the API inside compose — see the README.
SANDBOX_MANAGER_URL=http://localhost:4100
SANDBOX_MANAGER_TOKEN=dev-only-sandbox-manager-token-change-me
