# For `pnpm dev` against `compose.dev.yaml`.
NODE_ENV=development
# Requests arrive through the Next.js /api proxy.
TRUST_PROXY=1
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
CONTROL_DATABASE_URL=postgres://sqlscope:sqlscope@localhost:15432/sqlscope
SANDBOX_DATABASE_URL=postgres://sqlscope_provisioner:sandbox-provisioner@localhost:15433/postgres
REDIS_URL=redis://:sqlscope@localhost:16379
