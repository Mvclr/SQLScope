// SQLScope's own database. User SQL never runs here (concept §24, ADR 0001).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  PROVISIONING
  ACTIVE
  EXPIRED
  DESTROYED
  FAILED
}

/// Someone who signed up, so their work survives the sandbox.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  /// argon2id hash. The password itself never reaches the database.
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  projects     Project[]
  sessions     Session[]

  @@map("users")
}

/// A saved session: the statements that build a schema, replayable into a new sandbox.
model Project {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  /// SQL scripts in the order they were run.
  scripts   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("projects")
}

/// One disposable T1 sandbox: a database and a role on the sandbox cluster (ADR 0001).
model Session {
  id           String        @id @default(uuid()) @db.Uuid
  status       SessionStatus @default(PROVISIONING)
  /// Also the name of its role. Random, validated before being used in DDL.
  databaseName String        @unique @map("database_name")
  /// Credential of the ephemeral role. Lives only as long as the sandbox.
  rolePassword String        @map("role_password")
  /// sha256 of the client address with a server secret; never the address itself.
  clientHash   String        @map("client_hash")
  createdAt    DateTime      @default(now()) @map("created_at")
  lastActiveAt DateTime      @default(now()) @map("last_active_at")
  endedAt      DateTime?     @map("ended_at")
  endReason    String?       @map("end_reason")
  /// Set when the browser was signed in; an anonymous session is claimed on login.
  userId       String?       @map("user_id") @db.Uuid
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  events       SessionEvent[]

  @@index([status, lastActiveAt])
  @@index([clientHash, status])
  @@index([userId])
  @@map("sessions")
}

/// Append-only history of a session (ADR 0004). `seq` orders events within a session.
model SessionEvent {
  sessionId String   @map("session_id") @db.Uuid
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, seq])
  @@index([sessionId, type, seq])
  @@map("session_events")
}
