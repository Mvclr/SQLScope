{
  "name": "@sqlscope/api",
  "version": "0.0.0",
  "private": true,
  "description": "Public SQLScope API (NestJS modular monolith).",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "prisma migrate deploy && nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sqlscope/core": "workspace:*",
    "@sqlscope/engine": "workspace:*",
    "@sqlscope/explain": "workspace:*",
    "@sqlscope/security-rules": "workspace:*",
    "@sqlscope/sql-parser": "workspace:*",
    "cookie-parser": "1.4.7",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.1"
  }
}
