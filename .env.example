# Copy to .env before `docker compose up`. The data-service passwords have defaults for a
# local run; SESSION_SECRET does not — the API refuses to start in production with a value
# that ships in this repository.
CONTROL_DB_PASSWORD=sqlscope
SANDBOX_SUPERUSER_PASSWORD=sandbox-superuser
SANDBOX_PROVISIONER_PASSWORD=sandbox-provisioner
REDIS_PASSWORD=sqlscope
LOG_LEVEL=info
# Required. Generate a unique one, e.g. `openssl rand -base64 32` or
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
SESSION_SECRET=
# true once served over HTTPS
COOKIE_SECURE=false
