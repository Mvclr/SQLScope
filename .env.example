# Copy to .env before `docker compose up`. The data-service passwords have defaults for a
# local run; SESSION_SECRET and SANDBOX_MANAGER_TOKEN do not — the API and the sandbox
# manager refuse to start in production with a value that ships in this repository.
CONTROL_DB_PASSWORD=sqlscope
SANDBOX_SUPERUSER_PASSWORD=sandbox-superuser
SANDBOX_PROVISIONER_PASSWORD=sandbox-provisioner
REDIS_PASSWORD=sqlscope
LOG_LEVEL=info
# Required. Generate a unique one, e.g. `openssl rand -base64 32` or
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
SESSION_SECRET=
# true once served over HTTPS
COOKIE_SECURE=false
# Required. The API presents it to the sandbox manager, which starts containers on the host
# for whoever holds it. Generate it like SESSION_SECRET.
SANDBOX_MANAGER_TOKEN=
SANDBOX_MANAGER_DB_PASSWORD=sandbox-manager

# --- Production only (compose.prod.yaml) — see docs/DEPLOY.md ---------------------------
# Which published tag to run: "edge" is the tip of main, "sha-abc1234" pins one build, and
# a release tag such as "1.0.0" pins a version. Pin it to make a rollback a one-line change.
# SQLSCOPE_VERSION=edge
# Host port the web service listens on. 80 by default.
# WEB_PUBLIC_PORT=80
# Only needed on a fork: the registry path the images were published under.
# SQLSCOPE_IMAGE_PREFIX=ghcr.io/mvclr/sqlscope
