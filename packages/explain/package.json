{
  "name": "@sqlscope/explain",
  "version": "0.0.0",
  "private": true,
  "description": "Turns PostgreSQL execution plans into a typed tree, with the observations that make them teachable.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@sqlscope/core": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "vitest": "5.0.1"
  }
}
